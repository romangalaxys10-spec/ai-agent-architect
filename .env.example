# AI Agent Architect — environment configuration
# Copy to .env and fill in ONLY what you need. The framework is fully
# functional offline (EchoProvider) with zero keys configured.

# --- LLM providers (all optional; default = offline echo) --------------------
# Provider selector: echo (default, offline) | openai | anthropic
AGENT_LLM_PROVIDER=echo

# OpenAI-compatible (works with OpenAI, DeepSeek, GLM, Groq, Together, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# --- Safety & budgets ---------------------------------------------------------
# Hard spend ceiling per session (USD)
AGENT_MAX_BUDGET_USD=5.0
# Step budget for agent runs (advertised to the model = 80% of this)
AGENT_MAX_STEPS=25

# --- Observability --------------------------------------------------------------
# Where JSONL event logs go (empty = memory only)
AGENT_EVENT_LOG=

# --- Memory ---------------------------------------------------------------------
# Memory persistence path (empty = in-memory only)
AGENT_MEMORY_PATH=
